# Include ourselves as an extra root dependency to make our build targets
# available to GN.
# See https://chromium.googlesource.com/chromium/src/+/main/BUILD.gn
root_extra_deps = [ "//prebuilds" ]

# Only enable debug checks in non-release builds.
dcheck_always_on = false

# Don't perform a component build as we're interested in bundling everything
# into single archives.
is_component_build = false

# Disable the allocator shim, which would otherwise replace malloc() and
# operator new with PartitionAlloc in any program or library that links a
# prebuild. Memory allocated by a library would then be freed with a
# different allocator by the program that links it.
use_allocator_shim = false

# Disable the features that Chromium only supports when PartitionAlloc replaces
# malloc() through the allocator shim.
enable_backup_ref_ptr_support = false
use_alloc_token = false

# Don't use a separate data file for ICU, but embed it statically instead.
# This increases executable size, but simplifies distribution.
icu_use_data_file = false

# Disable WebUI code cache generation, which needs external startup data when
# the host and target CPUs differ, such as for macOS x64 on an arm64 host.
enable_webui_generate_code_cache = false
