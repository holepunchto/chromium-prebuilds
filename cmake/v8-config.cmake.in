if(TARGET v8::static)
  return()
endif()

get_filename_component(_v8_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

include(CMakeFindDependencyMacro)

# The packages are installed next to each other, either as separate prefixes or
# in a shared one.
find_dependency(c++ @VERSION@ HINTS "${_v8_prefix}" "${_v8_prefix}/..")

add_library(v8::headers INTERFACE IMPORTED)

set_target_properties(
  v8::headers
  PROPERTIES
  PACKAGE_VERSION "@VERSION@"
  INTERFACE_INCLUDE_DIRECTORIES "${_v8_prefix}/include"
  INTERFACE_COMPILE_DEFINITIONS "@COMPILE_DEFINITIONS@"
  INTERFACE_COMPILE_OPTIONS "@COMPILE_OPTIONS@"
  INTERFACE_LINK_LIBRARIES c++::headers
)

add_library(v8::static STATIC IMPORTED)

set_target_properties(
  v8::static
  PROPERTIES
  IMPORTED_LOCATION "${_v8_prefix}/lib/libv8${CMAKE_STATIC_LIBRARY_SUFFIX}"
  IMPORTED_LINK_INTERFACE_LANGUAGES CXX
  INTERFACE_LINK_LIBRARIES "v8::headers;c++::static;@LINK_LIBRARIES@"
)

unset(_v8_prefix)
