if(TARGET c++::static)
  return()
endif()

get_filename_component(_cxx_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

add_library(c++::headers INTERFACE IMPORTED)

set_target_properties(
  c++::headers
  PROPERTIES
  PACKAGE_VERSION "@VERSION@"
  INTERFACE_INCLUDE_DIRECTORIES "${_cxx_prefix}/include"
  INTERFACE_COMPILE_OPTIONS "@COMPILE_OPTIONS@"
)

add_library(c++::static STATIC IMPORTED)

set_target_properties(
  c++::static
  PROPERTIES
  IMPORTED_LOCATION "${_cxx_prefix}/lib/libc++${CMAKE_STATIC_LIBRARY_SUFFIX}"
  IMPORTED_LINK_INTERFACE_LANGUAGES CXX
  INTERFACE_LINK_LIBRARIES c++::headers
  INTERFACE_LINK_OPTIONS "@LINK_OPTIONS@"
)

unset(_cxx_prefix)
